# AthleteOS - example environment configuration.
# Copy this file to .env and fill in real values there. .env is gitignored
# and must never be committed; this file documents the variables only and
# must never contain a real secret.
#
# LOCAL DEVELOPMENT (this file's defaults): ATHLETEOS_PROVIDER=mock,
# ATHLETEOS_STORAGE_BACKEND=json - no API key or database needed to run
# the app at all.
#
# PRODUCTION (Render, once deployed): set these as Render's own
# environment variables (in its dashboard) - never in a committed file -
#   ATHLETEOS_PROVIDER=openrouter
#   ATHLETEOS_STORAGE_BACKEND=postgres
#   OPENROUTER_API_KEY=<real key>
#   DATABASE_URL=<the Supabase connection string>
# Everything else below can keep its default unless you want to override it.

# --- LLM provider selection --------------------------------------------
# Which meal-plan provider generate_meal_plan() uses: "mock" (default,
# deterministic, no API key needed), "claude", or "openrouter".
ATHLETEOS_PROVIDER=mock

# --- OpenRouter (used by ATHLETEOS_PROVIDER=openrouter, and by chat.py's
# "Ask AthleteOS" feature regardless of ATHLETEOS_PROVIDER) --------------
OPENROUTER_API_KEY=
# Optional overrides - safe to leave unset (defaults shown):
OPENROUTER_MODEL=openai/gpt-oss-120b:free
# Tried once, automatically, only if OPENROUTER_MODEL's call fails. Set to
# an empty string to disable fallback entirely.
OPENROUTER_FALLBACK_MODEL=openai/gpt-oss-20b:free
ATHLETEOS_OPENROUTER_MAX_TOKENS=3000
ATHLETEOS_OPENROUTER_EFFORT=low

# --- Claude / Anthropic (used only by ATHLETEOS_PROVIDER=claude) --------
ANTHROPIC_API_KEY=
# Optional overrides - safe to leave unset (defaults shown):
ATHLETEOS_LLM_MODEL=claude-opus-5
ATHLETEOS_LLM_MAX_TOKENS=3000
ATHLETEOS_LLM_EFFORT=low

# --- Storage backend (Phase 1) -----------------------------------------
# Which backend memory_manager.py uses for profiles/preferences/
# latest_plans/recipes/episodes: "json" (default, local memory/*.json
# files, no setup needed) or "postgres" (Supabase/Postgres - see
# postgres_memory_backend.py and schema.sql). The cache category always
# stays on local JSON files regardless of this setting.
ATHLETEOS_STORAGE_BACKEND=json

# Only required when ATHLETEOS_STORAGE_BACKEND=postgres. A Postgres
# connection string, e.g. Supabase's "Connection string" (URI format) from
# Project Settings -> Database. Leave unset while ATHLETEOS_STORAGE_BACKEND
# is "json" - it has no effect.
DATABASE_URL=
